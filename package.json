{
	"name": "kanbot",
	"version": "0.2.0",
	"description": "Run an autonomous dev team (Claude Code or Codex) from a GitHub Project board",
	"type": "module",
	"license": "MIT",
	"author": "Mikael Brevik",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mikaelbr/kanbot.git"
	},
	"homepage": "https://github.com/mikaelbr/kanbot#readme",
	"bugs": "https://github.com/mikaelbr/kanbot/issues",
	"keywords": [
		"github",
		"kanban",
		"agents",
		"claude-code",
		"codex",
		"automation",
		"cli"
	],
	"bin": {
		"kanbot": "src/cli.ts"
	},
	"files": [
		"src",
		"templates",
		"schema"
	],
	"engines": {
		"bun": ">=1.3"
	},
	"scripts": {
		"kanbot": "bun src/cli.ts",
		"test": "bun test",
		"check": "biome check .",
		"fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"schema": "bun -e \"await Bun.write('schema/config.schema.json', (await import('./src/config.ts')).renderConfigSchema())\"",
		"docs:dev": "pnpm --dir site dev",
		"docs:build": "pnpm --dir site build",
		"hashes": "bun scripts/known-hashes.ts",
		"prepublishOnly": "bun run check && bun run typecheck && bun test",
		"prepare": "lefthook install",
		"release:preview": "git-cliff --unreleased --bump --strip all && git-cliff --bumped-version"
	},
	"dependencies": {
		"citty": "^0.2.2",
		"node-notifier": "^12.1.0",
		"yaml": "^2.9.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@types/bun": "^1.4.4",
		"git-cliff": "^2.14.2",
		"lefthook": "^2.2.2",
		"typescript": "^7.0.2"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		],
		"rules": {
			"body-max-line-length": [
				0
			],
			"footer-max-line-length": [
				0
			]
		}
	}
}

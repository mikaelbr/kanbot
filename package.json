{
	"name": "kanbot",
	"version": "0.1.0",
	"description": "Run an autonomous dev team (Claude Code or Codex) from a GitHub Project board",
	"type": "module",
	"license": "MIT",
	"bin": {
		"kanbot": "./src/cli.ts"
	},
	"files": [
		"src",
		"templates",
		"schema"
	],
	"engines": {
		"bun": ">=1.3"
	},
	"scripts": {
		"kanbot": "bun src/cli.ts",
		"test": "bun test",
		"check": "biome check .",
		"fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"schema": "bun -e \"await Bun.write('schema/config.schema.json', (await import('./src/config.ts')).renderConfigSchema())\"",
		"docs:dev": "pnpm --dir site dev",
		"docs:build": "pnpm --dir site build",
		"hashes": "bun scripts/known-hashes.ts"
	},
	"dependencies": {
		"citty": "^0.2.2",
		"node-notifier": "^12.0.0",
		"yaml": "^2.9.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@types/bun": "^1.4.4",
		"@types/node-notifier": "^8.0.5",
		"typescript": "^7.0.2"
	}
}
